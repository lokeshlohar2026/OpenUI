# LLM Provider: gemini | groq | opencode
LLM_PROVIDER=gemini

# OpenCode
OPENCODE_API_KEY=sk-...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=mimo-v2.5-pro
OPENCODE_REASONING_EFFORT=null

# Groq
GROQ_API_KEY=gsk-...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=null

# Gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL (no defaults – must be set)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mf_saarthi_db
POSTGRES_USER=mf_saarthi_user
POSTGRES_PASSWORD=changeme
# Alternative PG_* aliases also supported: PG_HOST, PG_PORT, PG_DB, PG_USER, PG_PASS

# Backend
APP_HOST=127.0.0.1
APP_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Frontend (Vite – must be prefixed with VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8001
