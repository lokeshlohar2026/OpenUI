# OpenCode Provider Configuration (OpenCode Go Plan)
# Available OpenCode Go Models: deepseek-v4-flash (1M context), deepseek-v4-pro (1M context), minimax-m3 (1M context), qwen3.7-plus (1M context), mimo-v2.5 (1M context), gpt-5.6-luna (1.05M context), hy3 (256k context)
OPENCODE_API_KEY=sk-...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash
# Reasoning Effort: none (0 reasoning tokens for instant stream), low, medium, high, null
OPENCODE_REASONING_EFFORT=none

# PostgreSQL Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mf_saarthi_db
POSTGRES_USER=mf_saarthi_user
POSTGRES_PASSWORD=changeme

# Application Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8001
